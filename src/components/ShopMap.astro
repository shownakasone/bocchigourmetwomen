---
// 地図。たくさんのピンはまとめて表示（クラスタ）。絞り込み時は window イベントで更新
import type { Shop } from '../lib/data';
interface Props { shops: Shop[]; height?: string; zoom?: number }
const { shops, height = '420px', zoom } = Astro.props;
const pins = shops.filter((s) => s.lat != null).map(({ id, name, lat, lng, genre, city, approx }) => ({ id, name, lat, lng, genre, city, approx: !!approx }));
---
<div class="shop-map" style={`height:${height}`} data-pins={JSON.stringify(pins)} data-zoom={zoom ?? ''}></div>
<script>
  import L from 'leaflet';
  import 'leaflet.markercluster';
  import 'leaflet/dist/leaflet.css';
  import 'leaflet.markercluster/dist/MarkerCluster.css';

  type Pin = { id: string; name: string; lat: number; lng: number; genre: string; city: string; approx: boolean };
  const icon = (approx: boolean) => L.divIcon({ className: approx ? 'pin approx' : 'pin', html: '<span></span>', iconSize: [18, 18], iconAnchor: [9, 9] });
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

  document.querySelectorAll<HTMLElement>('.shop-map').forEach((el) => {
    const pins: Pin[] = JSON.parse(el.dataset.pins || '[]');
    const map = L.map(el, { scrollWheelZoom: false });
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors', maxZoom: 19,
    }).addTo(map);
    const single = pins.length <= 1;
    const layer = single ? L.layerGroup() : (L as any).markerClusterGroup({
      showCoverageOnHover: false, maxClusterRadius: 45,
      iconCreateFunction: (c: any) => L.divIcon({ className: 'cluster', html: `<span>${c.getChildCount()}</span>`, iconSize: [36, 36] }),
    });
    layer.addTo(map);

    const draw = (visible: Set<string> | null) => {
      layer.clearLayers();
      const shown = pins.filter((p) => !visible || visible.has(p.id));
      for (const p of shown) {
        L.marker([p.lat, p.lng], { icon: icon(p.approx) })
          .bindPopup(`<a href="/shops/${p.id}" class="pop"><small>${esc(p.city)}｜${esc(p.genre)}</small><b>${esc(p.name)}</b>${p.approx ? '<i>※位置はおおよそ（市町村）</i>' : ''}<em>詳しく見る →</em></a>`)
          .addTo(layer);
      }
      if (!shown.length) { map.setView([40.6, 140.6], 8); return; }
      if (el.dataset.zoom) map.setView([shown[0].lat, shown[0].lng], shown[0].approx ? 12 : Number(el.dataset.zoom));
      else map.fitBounds(L.latLngBounds(shown.map((p) => [p.lat, p.lng] as [number, number])), { padding: [30, 30], maxZoom: 15 });
    };
    draw(null);
    window.addEventListener('shops:filtered', (e) => draw(new Set((e as CustomEvent<string[]>).detail)));
    window.addEventListener('shops:map-shown', () => { map.invalidateSize(); });
  });
</script>
<style is:global>
  .shop-map { width: 100%; border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow); background: var(--paper-2); z-index: 0; }
  .shop-map .leaflet-tile-pane { filter: grayscale(.85) sepia(.25) contrast(.92) brightness(1.03); }
  .pin span { display: block; width: 20px; height: 20px; border-radius: 50%; background: var(--yellow); border: 4px solid #2e3442; box-shadow: 0 1px 4px rgba(0,0,0,.3); }
  .pin.approx span { background: #fff; border: 3px dashed #2e3442; }
  .cluster span { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 50%; background: #2e3442; color: #f5b82e; font: 600 13px var(--sans); border: 3px solid rgba(255,255,255,.85); box-shadow: 0 1px 4px rgba(0,0,0,.3); }
  .leaflet-popup-content-wrapper { border-radius: 2px; font-family: var(--sans); }
  .pop { display: grid; gap: 2px; color: #2b2622 !important; }
  .pop small { color: #6b625a; font-size: 11px; }
  .pop b { font-family: var(--serif); font-size: 15px; }
  .pop i { font-style: normal; font-size: 11px; color: #6b625a; }
  .pop em { font-style: normal; color: #b8432f; font-size: 12px; }
</style>
