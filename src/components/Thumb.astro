---
// 動画サムネ。画像がないときはロゴのお皿モチーフのプレースホルダー
interface Props { src?: string; label?: string; ratio?: string }
const { src, label = '', ratio = '16 / 9' } = Astro.props;
---
<div class="thumb" style={`aspect-ratio:${ratio}`}>
  {src ? <img src={src} alt="" loading="lazy" decoding="async" /> : (
    <div class="ph">
      <svg viewBox="0 0 100 100" aria-hidden="true"><circle cx="50" cy="50" r="34" fill="none" stroke="currentColor" stroke-width="4"/><circle cx="50" cy="50" r="24" fill="var(--yellow)"/></svg>
      <span>{label}</span>
    </div>
  )}
</div>
<style>
  .thumb { width: 100%; overflow: hidden; background: var(--paper-2); border-radius: 14px; }
  .thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s ease; }
  :global(a:hover) .thumb img { transform: scale(1.04); }
  .ph { height: 100%; display: grid; place-items: center; align-content: center; gap: 2px; color: var(--ink); }
  .ph svg { width: 30%; max-width: 90px; }
  .ph span { font-family: var(--round); font-size: 12px; font-weight: 700; color: var(--ink-2); }
</style>
