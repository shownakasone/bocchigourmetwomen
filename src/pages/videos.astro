---
import Base from '../layouts/Base.astro';
import VideoMonth from '../components/VideoMonth.astro';
import { getVideos, shopsOfVideo, fmtDate } from '../lib/data';

const videos = getVideos();
const groups = new Map<string, typeof videos>();
for (const v of videos) {
  const d = new Date(v.publishedAt);
  const key = `${d.getFullYear()}年${d.getMonth() + 1}月`;
  groups.set(key, [...(groups.get(key) ?? []), v]);
}
const years = [...new Set(videos.map((v) => new Date(v.publishedAt).getFullYear()))];
const keys = [...groups.keys()];
const months = [...groups].map(([month, list], gi) => ({ month, list, anchor: gi === 0 || !keys[gi - 1].startsWith(month.slice(0, 4)) ? `y${month.slice(0, 4)}` : undefined }));
const FIRST = 6;
// 7か月目より前は、必要な情報だけの小さなデータにする（表示するときに最初の月を型にして組み立てる）
const olderData = months.slice(FIRST).map(({ month, list, anchor }) => ({
  m: month, a: anchor ?? '',
  v: list.map((v) => [v.videoId, v.title, fmtDate(v.publishedAt), shopsOfVideo(v.videoId).map((s) => [s.id, s.name, s.genre, s.closed ? 1 : 0])]),
}));
---
<Base title="動画アーカイブ">
  <section class="wrap head">
    <p class="eyebrow">Archive</p>
    <h1>動画アーカイブ</h1>
    <p class="lead">これまでの全{videos.length}本。動画に出てきたお店のページへ移動できます。</p>
    <div class="tools">
      <input type="search" id="vq" placeholder="動画タイトルで検索（例：朝ラー、盛岡）" aria-label="動画を検索" />
      <nav class="years">{years.map((y) => <a href={`#y${y}`}>{y}</a>)}</nav>
    </div>
    <p id="vcount" class="vcount" aria-live="polite"></p>
  </section>
  {/* 最近6か月分だけを HTML で表示。残りはデータから必要なときに組み立てる（スマホで軽くするため） */}
  <div class="wrap" id="months">
    {months.slice(0, FIRST).map((m) => <VideoMonth {...m} />)}
  </div>
  <script type="application/json" id="older-data" set:html={JSON.stringify(olderData)} />
  {months.length > FIRST && <div class="wrap more-wrap"><button type="button" class="btn" id="more">もっと前の動画を見る</button></div>}
</Base>
<script>
  const input = document.getElementById('vq') as HTMLInputElement;
  const box = document.getElementById('months')!;
  type Ep = [string, string, string, [string, string, string, number][]];
  const older: { m: string; a: string; v: Ep[] }[] = JSON.parse(document.getElementById('older-data')!.textContent!);
  // 画面にある月・動画・お店を型にして、同じ見た目で組み立てる
  const protoMonth = box.querySelector<HTMLElement>('.month')!;
  const protoEp = box.querySelector<HTMLElement>('.ep:has(.ep-shops)') ?? box.querySelector<HTMLElement>('.ep')!;
  const protoLi = box.querySelector<HTMLElement>('.ep-shops li');
  const protoClosed = (() => { const t = protoLi?.querySelector('.tag')?.cloneNode(true) as HTMLElement | undefined; if (t) { t.className = 'tag closed'; t.textContent = '閉店'; } return t; })();
  function buildEp([id, title, date, shops]: Ep) {
    const el = protoEp.cloneNode(true) as HTMLElement;
    const url = `https://www.youtube.com/watch?v=${id}`;
    el.id = id;
    el.dataset.text = (title + ' ' + shops.map((s) => s[1]).join(' ')).toLowerCase();
    el.querySelectorAll<HTMLAnchorElement>('a.ep-media, h3 a').forEach((a) => (a.href = url));
    el.querySelector('img')!.src = `https://i.ytimg.com/vi/${id}/mqdefault.jpg`;
    el.querySelector('.date')!.textContent = date;
    el.querySelector('h3 a')!.textContent = title;
    const ul = el.querySelector('.ep-shops');
    if (ul && protoLi) {
      if (!shops.length) ul.remove();
      else ul.replaceChildren(...shops.map(([sid, name, genre, closed]) => {
        const li = protoLi.cloneNode(true) as HTMLElement;
        li.querySelectorAll('.tag.closed').forEach((t) => t.remove());
        const a = li.querySelector('a')!; a.href = `/shops/${sid}`; a.textContent = name;
        li.querySelector('.tag')!.textContent = genre;
        if (closed && protoClosed) li.append(protoClosed.cloneNode(true));
        return li;
      }));
    }
    return el;
  }
  function buildMonth({ m, a, v }: (typeof older)[number]) {
    const sec = protoMonth.cloneNode(false) as HTMLElement;
    if (a) sec.id = a; else sec.removeAttribute('id');
    sec.append(protoMonth.querySelector('h2')!.cloneNode(false));
    sec.querySelector('h2')!.textContent = m;
    sec.append(...v.map(buildEp));
    return sec;
  }
  const more = document.getElementById('more');
  const count = document.getElementById('vcount')!;
  // しまってある月を追加する（n を省略するとすべて）
  const reveal = (n = Infinity) => {
    box.append(...older.splice(0, n).map(buildMonth));
    if (!older.length) more?.parentElement?.remove();
  };
  more?.addEventListener('click', () => reveal(6));
  // 年のボタン：その年がまだ出ていなければ全部出してから移動
  document.querySelectorAll<HTMLAnchorElement>('.years a').forEach((a) => a.addEventListener('click', (e) => {
    const id = a.getAttribute('href')!.slice(1);
    if (!document.getElementById(id)) { e.preventDefault(); reveal(); document.getElementById(id)?.scrollIntoView({ behavior: 'smooth' }); }
  }));
  input.addEventListener('input', () => {
    reveal();
    const words = input.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
    let n = 0;
    for (const el of box.querySelectorAll<HTMLElement>('.ep')) { const ok = words.every((w) => el.dataset.text!.includes(w)); el.hidden = !ok; if (ok) n++; }
    for (const m of box.querySelectorAll<HTMLElement>('.month')) m.hidden = !m.querySelector('.ep:not([hidden])');
    count.textContent = words.length ? `${n} 本の動画` : '';
  });
  // 動画ページへの直リンク（#videoId）で来たときも表示する
  if (location.hash && !document.getElementById(location.hash.slice(1))) { reveal(); document.getElementById(location.hash.slice(1))?.scrollIntoView(); }
</script>
<style>
  .head { padding-top: 40px; }
  .head h1 { font-size: clamp(26px, 4vw, 34px); margin-top: 4px; }
  .lead { color: var(--ink-2); margin: 8px 0 20px; }
  .tools { display: flex; gap: 16px; align-items: center; flex-wrap: wrap; }
  .tools input { flex: 1 1 280px; font: inherit; font-size: 14px; padding: 10px 14px; color: var(--ink); background: var(--card); border: 1px solid var(--line); border-radius: 2px; }
  .tools input:focus { outline: 2px solid var(--shu); outline-offset: -1px; }
  .years { display: flex; gap: 6px; flex-wrap: wrap; }
  .years a { font-family: var(--serif); font-size: 14px; padding: 4px 12px; border: 1px solid var(--line); border-radius: 99px; }
  .years a:hover { border-color: var(--shu); color: var(--shu); }
  .vcount { font-family: var(--serif); margin: 12px 0 0; min-height: 1em; }
  .more-wrap { text-align: center; padding-top: 32px; }
  @media (max-width: 640px) { .tools input { font-size: 16px; } .years { overflow-x: auto; flex-wrap: nowrap; } }
</style>
