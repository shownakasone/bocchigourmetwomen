---
import Base from '../layouts/Base.astro';
import Thumb from '../components/Thumb.astro';
import ShopCard from '../components/ShopCard.astro';
import { getShops, getVideos, shopsOfVideo, thumb, fmtDate, countBy, isMorning, spend, watchUrl, CHANNEL_URL } from '../lib/data';

const videos = getVideos();
const shops = getShops();
const open = shops.filter((s) => !s.closed);
const latest = videos.find((v) => shopsOfVideo(v.videoId).length) ?? videos[0];
const latestShops = latest ? shopsOfVideo(latest.videoId) : [];
const morning = open.filter(isMorning).slice(0, 8);
const coin = open.filter((s) => { const n = spend(s); return n != null && n <= 600; }).slice(0, 8);
const favorites = open.filter((s) => s.visits.length >= 3).sort((a, b) => b.visits.length - a.visits.length).slice(0, 8);
const cities = countBy(open, (s) => s.city).filter(([c]) => c).slice(0, 14);
const genres = countBy(open, (s) => s.genre);
const prefs = countBy(open, (s) => s.pref);
const sections = [
  { eyebrow: 'Morning', title: '朝ラー・モーニング', lead: '朝からやっているお店。早起きした日のごほうびに。', shops: morning, href: '/shops?morning=1' },
  { eyebrow: 'One Coin', title: 'ワンコインで満足', lead: '600円以下でお腹いっぱいになれたお店。', shops: coin, href: '/shops?budget=~500' },
  { eyebrow: 'Favorite', title: '何度も通っているお店', lead: '3回以上訪れた、ぼっちグルメウーマンのお気に入り。', shops: favorites, href: '/shops?sort=visits' },
];
---
<Base>
  {latest && (
    <section class="hero">
      <div class="wrap hero-grid">
        <div class="hero-text">
          <p class="eyebrow">Today's Plate</p>
          <h1>ひとりで、<br />気ままに、<br /><span class="mark">おいしいもの。</span></h1>
          <p class="hero-lead">青森・岩手・秋田を中心に、ぼっちグルメウーマンが食べ歩いた<b>{shops.length}軒</b>のお店を集めました。</p>
          <form action="/shops" class="hero-search" role="search">
            <input type="search" name="q" placeholder="お店やメニューを検索" aria-label="お店を探す" />
            <button class="btn primary" type="submit">さがす</button>
          </form>
          <p class="schedule"><span>NEW</span>毎週 火曜日・金曜日 18時更新</p>
        </div>
        <a href={CHANNEL_URL} target="_blank" rel="noopener" class="plate" aria-label="YouTubeチャンネル ぼっちグルメウーマン">
          <img src="/brand/avatar.jpg" alt="Bocchi Gourmet Women" width="900" height="900" />
        </a>
      </div>
      <div class="wrap latest">
        <div class="latest-card">
          <p class="eyebrow">Latest Episode</p>
          <p class="latest-date">{fmtDate(latest.publishedAt)}</p>
          <h2><a href={watchUrl(latest.videoId)} target="_blank" rel="noopener">{latest.title}</a></h2>
          {latestShops.length > 0 && (
            <ol class="cover-shops">
              {latestShops.map((s, i) => (
                <li><a href={`/shops/${s.id}`}><span class="no">{i + 1}</span>{s.name}<span class="arrow">→</span></a></li>
              ))}
            </ol>
          )}
        </div>
      </div>
    </section>
  )}

  <section class="stats wrap">
    <div><b>{videos.length}</b><span>本の動画</span></div>
    <div><b>{shops.length}</b><span>軒のお店</span></div>
    <div><b>{countBy(shops, (s) => s.city).length}</b><span>の市町村</span></div>
  </section>

  {sections.map((sec) => sec.shops.length > 0 && (
    <section class="section wrap">
      <div class="section-head">
        <div><p class="eyebrow">{sec.eyebrow}</p><h2>{sec.title}</h2><p class="lead">{sec.lead}</p></div>
        <a class="more" href={sec.href}>もっと見る</a>
      </div>
      <div class="grid scroller">{sec.shops.map((s) => <ShopCard shop={s} />)}</div>
    </section>
  ))}

  <section class="section index-band">
    <div class="wrap index-grid">
      <div>
        <p class="eyebrow">Area</p>
        <h2>まちから探す</h2>
        <ul class="pref-list">
          {prefs.map(([p, n]) => <li><a href={`/shops?pref=${encodeURIComponent(p)}`}>{p}<span>{n}</span></a></li>)}
        </ul>
        <ul class="index-list">
          {cities.map(([c, n]) => <li><a href={`/shops?city=${encodeURIComponent(c)}`}>{c}<span>{n}</span></a></li>)}
        </ul>
      </div>
      <div>
        <p class="eyebrow">Genre</p>
        <h2>ジャンルから探す</h2>
        <ul class="index-list">
          {genres.map(([g, n]) => <li><a href={`/shops?genre=${encodeURIComponent(g)}`}>{g}<span>{n}</span></a></li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section wrap">
    <div class="section-head">
      <div><p class="eyebrow">Archive</p><h2>最近の動画</h2></div>
      <a class="more" href="/videos">すべての動画</a>
    </div>
    <div class="grid scroller">
      {videos.filter((v) => v.videoId !== latest?.videoId).slice(0, 8).map((v) => (
        <a href={`/videos#${v.videoId}`} class="vcard">
          <Thumb src={thumb(v)} label={fmtDate(v.publishedAt)} />
          <p class="date">{fmtDate(v.publishedAt)}</p>
          <h3>{v.title}</h3>
        </a>
      ))}
    </div>
  </section>

  <section class="wrap channel">
    <img src="/brand/character.jpg" alt="" width="84" height="84" loading="lazy" />
    <p>青森・岩手・秋田を中心に、ひとりで気軽に行けるお店を食べ歩いています。</p>
    <a class="btn primary" href={CHANNEL_URL} target="_blank" rel="noopener">チャンネル登録はこちら</a>
  </section>
</Base>
<script>
  import { markCards } from '../lib/mylog';
  markCards();
</script>
<style>
  .hero { position: relative; padding: 40px 0 0; overflow: hidden; }
  .hero::before { content: ''; position: absolute; right: -10%; top: -30%; width: 70%; aspect-ratio: 1; border-radius: 50%; background: var(--pink-soft); z-index: -1; }
  .hero-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(24px, 5vw, 64px); align-items: center; }
  .hero-text h1 { font-size: clamp(30px, 4.6vw, 52px); font-weight: 900; line-height: 1.35; margin: 8px 0 18px; }
  .mark { background: linear-gradient(transparent 62%, var(--yellow) 62%); padding: 0 4px; }
  .hero-lead { color: var(--ink-2); margin: 0 0 22px; }
  .hero-lead b { color: var(--ink); }
  .hero-search { display: flex; gap: 8px; background: var(--card); padding: 6px; border-radius: 99px; box-shadow: var(--shadow); max-width: 460px; }
  .hero-search input { flex: 1 1 0; width: 0; min-width: 0; border: 0; background: transparent; font: inherit; font-size: 15px; padding: 0 16px; color: var(--ink); outline: none; -webkit-appearance: none; appearance: none; border-radius: 0; }
  .hero-search input::-webkit-search-decoration, .hero-search input::-webkit-search-cancel-button { -webkit-appearance: none; }
  .hero-search .btn { flex: none; white-space: nowrap; }
  .schedule { display: inline-flex; align-items: center; gap: 8px; margin: 18px 0 0; font-size: 13px; font-weight: 500; color: var(--ink-2); }
  .schedule span { background: var(--shu); color: #fff; font-size: 10px; font-weight: 700; padding: 1px 8px; border-radius: 99px; letter-spacing: .1em; }
  .plate { position: relative; display: block; width: min(100%, 440px); aspect-ratio: 1; margin: 0 auto; border-radius: 50%; background: #fff; box-shadow: 0 24px 60px rgba(46,52,66,.16); overflow: hidden; transition: transform .4s ease; }
  .plate:hover { transform: rotate(-4deg) scale(1.02); }
  .plate img { width: 100%; height: 100%; object-fit: cover; transform: scale(1.32); }
  .latest { margin-top: 36px; position: relative; }
  .latest-card { background: var(--card); border-radius: 24px; box-shadow: var(--shadow); padding: 24px clamp(20px, 3vw, 36px); display: grid; grid-template-columns: auto 1fr; gap: 4px 24px; align-items: start; }
  .latest-card .eyebrow { grid-column: 1; }
  .latest-date { grid-column: 1; margin: 0; font-size: 12px; color: var(--ink-2); }
  .latest-card h2 { grid-column: 2; grid-row: 1 / span 2; font-size: clamp(16px, 2vw, 20px); }
  .latest-card h2 a:hover { color: var(--shu); }
  .cover-shops { grid-column: 2; list-style: none; padding: 0; margin: 8px 0 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .cover-shops a { display: inline-flex; align-items: center; gap: 8px; padding: 6px 14px 6px 6px; border-radius: 99px; background: var(--paper-2); font-weight: 500; font-size: 14px; }
  .cover-shops a:hover { background: var(--yellow); }
  .no { display: grid; place-items: center; width: 22px; height: 22px; border-radius: 50%; background: var(--ink); color: var(--paper); font-size: 11px; font-weight: 700; }
  .arrow { color: var(--ink-2); }
  @media (max-width: 820px) {
    .hero-grid { grid-template-columns: 1fr; }
    .plate { display: none; }
    .hero-text h1 { font-size: clamp(24px, 8vw, 30px); margin: 4px 0 12px; word-break: keep-all; overflow-wrap: anywhere; }
    .hero-text h1 br:first-of-type { display: none; }
    .hero-lead { font-size: 14px; margin-bottom: 16px; }
    .hero-search { max-width: none; }
    .hero-search input { font-size: 16px; padding: 0 10px 0 14px; }
    .hero-search .btn { padding: 10px 16px; font-size: 14px; }
    .hero-grid { gap: 16px; text-align: left; }
    .hero { padding-top: 20px; }
    .latest { margin-top: 24px; }
    .latest-card { grid-template-columns: 1fr; }
    .latest-card h2, .cover-shops { grid-column: 1; grid-row: auto; }
  }

  .stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; text-align: center; padding-top: 40px; padding-bottom: 8px; }
  .stats div { display: flex; flex-direction: column; justify-content: center; align-items: center; aspect-ratio: 1; max-width: 150px; width: 100%; margin: 0 auto; border-radius: 50%; background: var(--card); box-shadow: var(--shadow), inset 0 0 0 6px var(--yellow-soft); }
  .stats b { font-family: var(--round); font-size: clamp(26px, 5vw, 40px); font-weight: 900; line-height: 1.1; }
  .stats span { font-size: 12px; color: var(--ink-2); }
  .lead { color: var(--ink-2); font-size: 13px; margin: 4px 0 0; }

  .index-band { background: var(--ink); color: var(--paper); margin-top: 48px; padding-bottom: 64px; border-radius: 40px 40px 0 0; }
  .index-band .eyebrow { color: var(--yellow); }
  .index-band h2 { color: #fff; }
  .index-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; }
  @media (max-width: 640px) { .index-grid { grid-template-columns: 1fr; } .index-band { border-radius: 28px 28px 0 0; } }
  .pref-list { list-style: none; padding: 0; margin: 16px 0 8px; display: flex; flex-wrap: wrap; gap: 8px; }
  .pref-list a { display: inline-flex; gap: 8px; padding: 6px 16px; border-radius: 99px; background: var(--yellow); color: #2e3442; font-family: var(--round); font-weight: 700; }
  .pref-list a:hover { background: #fff; }
  .pref-list span { font-size: 12px; opacity: .7; }
  .index-list span { font-family: var(--sans); font-size: 12px; color: rgba(255,255,255,.55); }
  .index-list { list-style: none; padding: 0; margin: 16px 0 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 0 24px; }
  .index-list a { display: flex; justify-content: space-between; padding: 10px 0; border-bottom: 1px dashed rgba(255,255,255,.18); font-family: var(--round); font-weight: 500; font-size: 15px; color: #fff; }
  .index-list a:hover { color: var(--yellow); }
  @media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) .index-band { background: #11131a; } }

  .vcard .date { font-size: 12px; color: var(--ink-2); margin: 10px 0 0; }
  .vcard h3 { font-size: 14px; }
  .vcard:hover h3 { color: var(--shu); }
  .vcard { display: block; }
  .channel { display: flex; align-items: center; justify-content: center; gap: 20px; flex-wrap: wrap; text-align: left; padding-top: 32px; padding-bottom: 8px; color: var(--ink-2); }
  .channel img { width: 84px; height: 84px; border-radius: 50%; object-fit: cover; object-position: 50% 20%; border: 5px solid var(--pink); }
</style>
